# Copiar a .env (NO versionar) o definir como variables del servidor/cPanel/Jenkins
DB_URL=jdbc:mysql://localhost:3306/rapimarket_minimarket
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
APP_CRYPTO_KEY=
CORS_ALLOWED_ORIGINS=https://tu-frontend.com
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APIS_TOKEN_RUC=
APIS_TOKEN_DNI=
UPLOAD_DIR=/home/rapimarket/public_html/uploads
SSL_KEYSTORE_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
FRONTEND_URL=https://tu-frontend.com
APP_SEED_ENABLED=true
APP_SEED_ADMIN_USERNAME=alez
APP_SEED_ADMIN_PASSWORD=1234

# ---- Despliegue en la nube (ver docs/DESPLIEGUE.md) ----
SPRING_PROFILES_ACTIVE=prod
# Railway los completa solo al enlazar el servicio MySQL: MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
APP_SEED_DEMO=false
# PORT lo define el proveedor
